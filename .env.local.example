METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
INTERNAL_API_KEY=          # la que Claude usará en el header x-api-key
BLOB_READ_WRITE_TOKEN=     # lo genera Vercel al crear el Blob store
DATABASE_URL=              # Vercel Postgres / Neon
AUTH_SECRET=                # para el login de la UI web (next-auth) — genera con `openssl rand -hex 32`
AUTH_USER_EMAIL=            # único usuario permitido en /login (equipo de una persona)
AUTH_USER_PASSWORD=         # contraseña de ese usuario — elígela tú, no la genera el agente
